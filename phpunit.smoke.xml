<?xml version="1.0" encoding="UTF-8"?>
<!-- S7: the smoke suites, never part of `composer test`.
     sandbox:    `composer smoke`, needs OPENPROVIDER_SANDBOX_USERNAME and OPENPROVIDER_SANDBOX_PASSWORD and
                 reaches https://api.sandbox.openprovider.nl.
     production: `composer smoke:production`, needs OPENPROVIDER_PRODUCTION_USERNAME and
                 OPENPROVIDER_PRODUCTION_PASSWORD and reaches https://api.openprovider.eu, read-only. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         executionOrder="default"
         beStrictAboutOutputDuringTests="true"
         failOnEmptyTestSuite="true"
         failOnRisky="true"
         failOnSkipped="true"
         failOnIncomplete="true"
         failOnWarning="true"
         failOnNotice="true"
         failOnDeprecation="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerErrors="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerWarnings="true">
    <testsuites>
        <testsuite name="sandbox">
            <file>smoke/SandboxSmokeTest.php</file>
        </testsuite>
        <testsuite name="production">
            <file>smoke/ProductionSmokeTest.php</file>
        </testsuite>
    </testsuites>
</phpunit>
