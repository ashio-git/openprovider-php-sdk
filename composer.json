{
    "name": "ashio/openprovider-php-sdk",
    "description": "Modern, fully-tested PHP SDK for the OpenProvider API with 100% test coverage",
    "keywords": ["openprovider", "api", "sdk", "domain", "dns", "ssl", "php"],
    "homepage": "https://github.com/ashio-git/openprovider-php-sdk",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Ashio Team",
            "email": "dev@ashio.com"
        }
    ],
    "support": {
        "issues": "https://github.com/ashio-git/openprovider-php-sdk/issues",
        "source": "https://github.com/ashio-git/openprovider-php-sdk"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.8.1",
        "ext-json": "*",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5",
        "phpstan/phpstan": "^1.10 || ^2.0",
        "vimeo/psalm": "^5.0 || ^6.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Ashio\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ashio\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text --coverage-clover coverage.xml",
        "analyse": "phpstan analyse",
        "psalm": "psalm",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "quality": [
            "@cs:check",
            "@analyse",
            "@psalm",
            "@test"
        ]
    }
}
