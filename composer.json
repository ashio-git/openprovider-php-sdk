{
    "name": "ashio/openprovider-php-sdk",
    "description": "PHP SDK for the Openprovider REST API (/v1)",
    "keywords": [
        "openprovider",
        "api",
        "sdk",
        "domain",
        "dns",
        "ssl",
        "php"
    ],
    "homepage": "https://github.com/ashio-git/openprovider-php-sdk",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Ashio Team",
            "email": "dev@ashio.com"
        }
    ],
    "support": {
        "issues": "https://github.com/ashio-git/openprovider-php-sdk/issues",
        "source": "https://github.com/ashio-git/openprovider-php-sdk"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.15.2",
        "guzzlehttp/psr7": "^2.7",
        "psr/http-client": "^1.0.3",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "vimeo/psalm": "^6.0",
        "friendsofphp/php-cs-fixer": "^3.75",
        "psr/simple-cache": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Ashio\\OpenProvider\\": "src/",
            "Ashio\\": "legacy/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ashio\\OpenProvider\\Tests\\": "tests/",
            "Ashio\\OpenProvider\\Tools\\": "tools/src/",
            "Ashio\\Tests\\": "legacy/tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text --coverage-clover coverage.xml",
        "analyse": [
            "phpstan analyse --no-progress",
            "phpstan analyse --no-progress -c phpstan-legacy.neon"
        ],
        "psalm": "psalm",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "quality": [
            "@cs:check",
            "@analyse",
            "@psalm",
            "@test"
        ],
        "spec:verify": [
            "php tools/spec-sync --verify",
            "php tools/spec-merge --check",
            "php tools/generate errors --check"
        ]
    },
    "suggest": {
        "psr/simple-cache": "Share the API token between processes with Psr16TokenStore"
    },
    "config": {
        "sort-packages": true
    }
}
